# Copy to .env and fill in YOUR OWN server's values. .env is git-ignored.
# --- proxy core ---
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_MODE=forward
# Your own server as reverse-proxy upstream (its DNS / IP is yours):
# PROXY_MODE=reverse
# PROXY_UPSTREAM=http://127.0.0.1:9000
OWN_SERVER_DNS=localhost
OWN_SERVER_IP=127.0.0.1
OWN_SERVER_PORT=9000

# --- optional auth / limits ---
# PROXY_AUTH=user:password
# PROXY_CACHE_TTL=60
# PROXY_RATE_LIMIT=120

# --- payload viewer (your own hosts only) ---
PAYLOAD_CAPTURE=1
PAYLOAD_ALLOW_HOSTS=127.0.0.1,localhost
PAYLOAD_MAX_BYTES=4096

# --- optional body decryption for YOUR server ---
# If your server encrypts bodies with AES-128-CBC (same style you use
# server-side), put YOUR key/IV here: 32 hex chars each, or raw 16 chars.
# Never commit real values. Requires: pip install cryptography
# PAYLOAD_AES_KEY=
# PAYLOAD_AES_IV=

# --- LGEB-format bundles from YOUR server A (0.5.0) ---
# Server B reads A's LGEB bundles using the same derivation structure:
# SHA-256(salt + "contentHash:resVersion") -> key[0:16] / iv[16:32],
# AES-128-CBC/PKCS#7, header b"LGEB" + resVersion u32 LE.
# The salt is A's own and must be supplied here — it is NOT built in.
# PAYLOAD_LGEB=1
# PAYLOAD_LGEB_SALT_HEX=
# PAYLOAD_LGEB_CONTENT_HASH=

# --- intercept (hold / release / drop), YOUR hosts only (0.6.0) ---
# Parks each request (transfer) and response (receive) in the dashboard
# until you Release or Drop it; INTERCEPT_TIMEOUT seconds, then forwards.
# Same hard-disable for Bilibili domains as payload capture.
# INTERCEPT=1
# INTERCEPT_ALLOW_HOSTS=127.0.0.1,localhost
# INTERCEPT_TIMEOUT=30
